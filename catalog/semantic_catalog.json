{
  "version": "2026.11.1",
  "name": "Acme demo catalog",
  "description": "Sample ontology over the built-in demo BigQuery tables (sales and CRM). Replace with the real catalog when it's available.",
  "tables": [
    {"name": "orders", "label": "Orders", "table": "acme-analytics.sales.orders", "primary_key": "order_id", "time_column": "created_at",
     "description": "One row per customer order", "synonyms": ["order", "purchases", "transactions"]},
    {"name": "order_items", "label": "Order lines", "table": "acme-analytics.sales.order_items", "primary_key": "order_item_id",
     "description": "Products included in each order", "synonyms": ["order lines", "line items", "basket items"]},
    {"name": "customers", "label": "Customers", "table": "acme-analytics.sales.customers", "primary_key": "customer_id", "time_column": "signup_ts",
     "description": "Customer details", "synonyms": ["customer", "clients", "buyers"]},
    {"name": "products", "label": "Products", "table": "acme-analytics.sales.products", "primary_key": "product_id",
     "description": "Product catalogue", "synonyms": ["product", "items", "catalogue"]},
    {"name": "regions", "label": "Regions", "table": "acme-analytics.sales.regions", "primary_key": "region",
     "description": "Region names and sales territories", "synonyms": ["territories table"]},
    {"name": "returns", "label": "Returns", "table": "acme-analytics.sales.returns", "primary_key": "return_id", "time_column": "returned_at",
     "description": "Returned orders and refund reasons", "synonyms": ["returned orders", "refunds"]},
    {"name": "accounts", "label": "Accounts", "table": "acme-analytics.crm.accounts", "primary_key": "account_id", "time_column": "opened_date",
     "description": "Customer accounts and their current state", "synonyms": ["account", "subscriptions"]},
    {"name": "churn_events", "label": "Churn events", "table": "acme-analytics.crm.churn_events", "primary_key": "churn_event_id", "time_column": "churned_date",
     "description": "One row each time an account closes", "synonyms": ["closures", "cancellations"]}
  ],
  "metrics": [
    {"name": "revenue", "label": "Revenue", "table": "orders", "agg": "sum", "column": "amount", "format": "currency",
     "description": "Total order value", "synonyms": ["sales", "turnover", "takings", "gmv", "order value", "total sales"]},
    {"name": "order_count", "label": "Number of orders", "table": "orders", "agg": "count", "format": "number",
     "description": "How many orders were placed", "synonyms": ["orders placed", "order volume", "number of orders", "how many orders"]},
    {"name": "average_order_value", "label": "Average order value", "table": "orders", "agg": "ratio",
     "numerator": "revenue", "denominator": "order_count", "format": "currency",
     "description": "Revenue divided by the number of orders", "synonyms": ["aov", "basket size", "avg order value"]},
    {"name": "buying_customers", "label": "Buying customers", "table": "orders", "agg": "count_distinct", "column": "customer_id",
     "description": "Distinct customers who placed at least one order", "synonyms": ["active customers", "unique customers", "customer count"]},
    {"name": "units_sold", "label": "Units sold", "table": "order_items", "agg": "sum", "column": "quantity",
     "description": "Total quantity sold", "synonyms": ["quantity sold", "volume sold", "units"]},
    {"name": "product_revenue", "label": "Product revenue", "table": "order_items", "agg": "sum", "column": "line_amount", "format": "currency",
     "description": "Revenue from order lines, for splitting by product", "synonyms": ["line revenue", "sales by product"]},
    {"name": "refund_amount", "label": "Refund amount", "table": "returns", "agg": "sum", "column": "refund_amount", "format": "currency",
     "description": "Total amount refunded", "synonyms": ["refunds paid", "refund value"]},
    {"name": "return_count", "label": "Number of returns", "table": "returns", "agg": "count",
     "description": "How many orders were returned", "synonyms": ["returns count", "number of returns"]},
    {"name": "return_rate", "label": "Return rate", "table": "returns", "agg": "ratio", "numerator": "return_count", "denominator": "order_count",
     "format": "percent", "description": "Returns as a share of orders", "synonyms": ["returns ratio", "rate of returns"]},
    {"name": "account_count", "label": "Number of accounts", "table": "accounts", "agg": "count",
     "description": "How many accounts exist", "synonyms": ["accounts total", "number of accounts"]},
    {"name": "monthly_recurring_revenue", "label": "Monthly recurring revenue", "table": "accounts", "agg": "sum", "column": "monthly_fee", "format": "currency",
     "description": "Sum of monthly fees across accounts", "synonyms": ["mrr", "recurring revenue", "subscription revenue"]},
    {"name": "churned_accounts", "label": "Churned accounts", "table": "churn_events", "agg": "count",
     "description": "How many accounts closed", "synonyms": ["churn", "lost accounts", "attrition"]}
  ],
  "dimensions": [
    {"name": "order_date", "label": "Order date", "table": "orders", "column": "created_at", "type": "time",
     "time_grains": ["date", "week", "month", "quarter", "year"], "synonyms": ["order time", "when ordered", "purchase date"]},
    {"name": "order_status", "label": "Order status", "table": "orders", "column": "status", "synonyms": ["status", "order state"]},
    {"name": "sales_channel", "label": "Sales channel", "table": "orders", "column": "channel", "synonyms": ["channel", "order channel"]},
    {"name": "currency", "label": "Currency", "table": "orders", "column": "currency", "synonyms": ["currency code"]},
    {"name": "customer_region", "label": "Customer region", "table": "customers", "column": "region", "synonyms": ["region", "area", "geography"]},
    {"name": "customer_segment", "label": "Customer segment", "table": "customers", "column": "segment", "synonyms": ["segment", "customer type"]},
    {"name": "signup_date", "label": "Signup date", "table": "customers", "column": "signup_ts", "type": "time",
     "time_grains": ["date", "month", "year"], "synonyms": ["joined date", "customer since"]},
    {"name": "customer_email", "label": "Customer email", "table": "customers", "column": "email", "pii": true, "synonyms": ["email address"]},
    {"name": "product_name", "label": "Product", "table": "products", "column": "product_name", "synonyms": ["product name"]},
    {"name": "product_category", "label": "Product category", "table": "products", "column": "category", "synonyms": ["category", "product line"]},
    {"name": "territory", "label": "Sales territory", "table": "regions", "column": "territory", "synonyms": ["territory", "sales territory"]},
    {"name": "return_reason", "label": "Return reason", "table": "returns", "column": "reason", "synonyms": ["why returned", "refund reason"]},
    {"name": "return_date", "label": "Return date", "table": "returns", "column": "returned_at", "type": "time",
     "time_grains": ["date", "week", "month"], "synonyms": ["returned on"]},
    {"name": "account_plan", "label": "Plan", "table": "accounts", "column": "plan", "synonyms": ["plan", "tier", "product plan"]},
    {"name": "account_region", "label": "Account region", "table": "accounts", "column": "region", "synonyms": ["account area"]},
    {"name": "account_active", "label": "Account is active", "table": "accounts", "column": "is_active", "type": "boolean", "synonyms": ["active accounts flag"]},
    {"name": "churn_reason", "label": "Churn reason", "table": "churn_events", "column": "churn_reason", "synonyms": ["why churned", "closure reason"]},
    {"name": "churn_date", "label": "Churn date", "table": "churn_events", "column": "churned_date", "type": "time",
     "time_grains": ["date", "month", "quarter"], "synonyms": ["churned on", "closure date"]}
  ],
  "joins": [
    {"name": "order_items_to_orders", "left": "order_items", "right": "orders", "on": [{"left": "order_id", "right": "order_id"}], "relationship": "many_to_one"},
    {"name": "orders_to_customers", "left": "orders", "right": "customers", "on": [{"left": "customer_id", "right": "customer_id"}], "relationship": "many_to_one"},
    {"name": "order_items_to_products", "left": "order_items", "right": "products", "on": [{"left": "product_id", "right": "product_id"}], "relationship": "many_to_one"},
    {"name": "customers_to_regions", "left": "customers", "right": "regions", "on": [{"left": "region", "right": "region"}], "relationship": "many_to_one"},
    {"name": "returns_to_orders", "left": "returns", "right": "orders", "on": [{"left": "order_id", "right": "order_id"}], "relationship": "many_to_one"},
    {"name": "churn_events_to_accounts", "left": "churn_events", "right": "accounts", "on": [{"left": "account_id", "right": "account_id"}], "relationship": "many_to_one"}
  ],
  "synonyms": [
    {"term": "money in", "concept": "metric:revenue"},
    {"term": "customer churn", "concept": "metric:churned_accounts"}
  ]
}
