# Copy to .env and adjust. All settings use the SH_ prefix.

# Where the SQLite database (including the ontology graph) and the Chroma index are kept
# SH_DATA_DIR=C:\Users\me\AppData\Local\SemanticHub
# The semantic catalog: seeds the graph store, and is the fallback when the graph can't be used
# SH_CATALOG_PATH=catalog/semantic_catalog.json

# Only this computer can reach the app (there is no sign-in)
SH_HOST=127.0.0.1
SH_PORT=8765
SH_OPEN_BROWSER=true

# demo = built-in sample tables; live = real BigQuery via Application Default Credentials
SH_METADATA_MODE=demo
# SH_GCP_BILLING_PROJECT=my-billing-project
# SH_BQ_ALLOWED_PROJECTS=acme-analytics

# mock = built-in stand-in; real = corporate Cortex client (app/services/cortex/real.py)
SH_CORTEX_MODE=mock
# SH_CORTEX_ENDPOINT=
# SH_CORTEX_API_KEY=
# SH_CORTEX_CHAT_MODEL=default
# SH_CORTEX_EMBED_MODEL=default
# SH_CORTEX_TIMEOUT=60

# Vector matches below this cosine similarity are ignored (tune for the real Cortex embedding model)
# SH_RETRIEVAL_MIN_SIMILARITY=0.25

# Query planning
# SH_DEFAULT_MONTHS=12      # period used for a trend when the question names none
# SH_DEFAULT_LIMIT=500
# SH_MAX_ROWS=5000
# SH_PLAN_ATTEMPTS=2        # first try + one retry with the reasons a plan was rejected

# Sessions
# SH_MAX_SESSION_TABLES=60

# Looker: placeholder for a future integration ("off" until it's built)
SH_LOOKER_MODE=off
# SH_LOOKER_BASE_URL=
# SH_LOOKER_CLIENT_ID=
# SH_LOOKER_CLIENT_SECRET=

# Guardrails
# SH_ALLOW_PII=false        # allow grouping by / filtering on personal-data dimensions
# SH_LARGE_TABLE_GB=50      # tables this big are limited to a period on their partition date
# SH_MAX_GROUP_BY=4         # warn above this many group-by dimensions

# Seed the graph store from the catalog, and build the metadata index, the first time the app starts
SH_AUTO_BOOTSTRAP=true
SH_AUTO_INDEX=true
# SH_ENABLE_API_DOCS=false
